{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Write(./raw/**)",
      "Edit(./raw/**)",
      "Write(./inbox/**)",
      "Edit(./inbox/**)"
    ],
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(cut:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(du:*)",
      "Bash(diff:*)",
      "Bash(file:*)",
      "Bash(unzip -p:*)",
      "Bash(date:*)",
      "Bash(open:*)",
      "Bash(mkdir:*)",
      "Bash(curl -s https://eutils.ncbi.nlm.nih.gov/*)",
      "Bash(bash .claude/skills/paper-search/pubmed.sh:*)",
      "Bash(./.claude/hooks/lint-scan.sh:*)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/inbox-check.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/size-check.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/morning-brief.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/night-review.sh\""
          }
        ]
      }
    ]
  }
}
